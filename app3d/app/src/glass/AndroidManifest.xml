<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Screen 3D (ScreenWeaveService): draw over other apps, keep capturing in a
         foreground service. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />

    <application>
        <activity
            android:name=".glass.ScreenWeaveActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <service
            android:name=".glass.ScreenWeaveService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection|camera" />
        <!-- Quick Settings tile that starts / ends Screen 3D. -->
        <service
            android:name=".glass.ScreenTileService"
            android:exported="true"
            android:icon="@drawable/ic_screen3d"
            android:label="@string/screen3d_tile"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <!-- 3D 맞추기 도구: SpatialGlass 필름의 렌즈 값(간격·기울기·위상·추적 세기)을 맞추고
             SBS 사진을 3D 로 본다. 플레이어가 같은 값을 쓴다.
             런처 아이콘은 두지 않는다 — 같은 앱의 두 번째 아이콘을 지우면 앱이 통째로 지워져
             둘 다 사라진다. DepthFlix 목록 화면의 "3D 맞추기" 버튼으로 연다. -->
        <activity
            android:name=".glass.GlassToolActivity"
            android:label="@string/glass_tool_label"
            android:exported="true"
            android:screenOrientation="landscape"
            android:launchMode="singleTop"
            android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>
    </application>
</manifest>
